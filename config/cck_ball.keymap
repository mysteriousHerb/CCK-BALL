#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&mt { flavor = "tap-preferred"; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    hml: hml {
        compatible = "zmk,behavior-hold-tap";
        label = "HML";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-on-release;
        hold-trigger-key-positions = <6 30 18 42 56 55 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 43 44 45 46 47 57 58 59 54>;
    };

    hmr: hmr {
        compatible = "zmk,behavior-hold-tap";
        label = "HMR";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "balanced";
        hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 53>;
        hold-trigger-on-release;
    };

    mt_mkp: mt_mkp {
        compatible = "zmk,behavior-hold-tap";
        label = "MT_MKP";
        bindings = <&mkp>, <&mkp>;

        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
    };

    left_brackets: left_brackets {
        compatible = "zmk,behavior-tap-dance";
        label = "LEFT_BRACKETS";
        #binding-cells = <0>;
        bindings =
            <&kp LEFT_PARENTHESIS>,
            <&kp LEFT_BRACKET>,
            <&kp LEFT_BRACE>,
            <&kp LESS_THAN>;
    };

    right_brackets: right_brackets {
        compatible = "zmk,behavior-tap-dance";
        label = "RIGHT_BRACKETS";
        #binding-cells = <0>;
        bindings =
            <&kp RIGHT_PARENTHESIS>,
            <&kp RIGHT_BRACKET>,
            <&kp RIGHT_BRACE>,
            <&kp GREATER_THAN>;
    };

    behaviors {
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&mt ESCAPE GRAVE  &mt F1 N1          &mt F2 N2    &mt F3 N3    &mt F4 N4          &mt F5 N5  &mt F6 N6  &mt F7 N7      &mt F8 N8        &mt F9 N9         &mt MINUS N0       &mt EQUAL MINUS
&kp TAB           &hml LEFT_SHIFT Q  &kp W        &kp E        &kp R              &kp T      &kp Y      &kp U          &kp I            &kp O             &kp P              &kp EQUAL
&kp BACKSPACE     &hml LCTRL A       &hml LGUI S  &hml LALT D  &hml LEFT_SHIFT F  &kp G      &kp H      &hmr RSHIFT J  &hmr RALT K      &hmr LGUI L       &hmr RCTRL SEMI    &kp SQT
&kp LEFT_SHIFT    &kp Z              &kp X        &kp C        &lt 3 V            &lt 2 B    &lt 3 N    &lt 3 M        &kp COMMA        &kp DOT           &kp SLASH          &kp BSLH
&kp LEFT_CONTROL  &lt 4 LEFT_GUI     &mo 5        &mkp LCLK    &mkp RCLK          &mo 1      &mkp LCLK  &caps_word     &mt ENTER SPACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DEL
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        coding_symbol {
            bindings = <
&trans  &trans     &trans    &trans     &trans        &trans               &trans     &trans                                  &trans                          &trans                      &trans        &trans
&trans  &trans     &trans    &trans     &trans        &trans               &trans     &left_brackets                          &kp UP                          &right_brackets             &kp MINUS     &trans
&trans  &trans     &trans    &trans     &trans        &trans               &trans     &kp LEFT                                &kp DOWN                        &kp RIGHT                   &kp EQUAL     &trans
&trans  &kp LCTRL  &kp PLUS  &kp MINUS  &kp ASTERISK  &mt BACKSLASH SLASH  &trans     &mt RIGHT_PARENTHESIS LEFT_PARENTHESIS  &mt RIGHT_BRACKET LEFT_BRACKET  &mt RIGHT_BRACE LEFT_BRACE  &kp UP_ARROW  &trans
&trans  &trans     &trans    &trans     &trans        &trans               &kp RCTRL  &kp F2                                  &kp F5                          &kp LEFT                    &kp DOWN      &kp RIGHT
            >;
        };

        BT_layers {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &trans  &trans  &trans  &trans  &trans
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &out OUT_TOG  &out OUT_BLE  &out OUT_USB  &out OUT_TOG  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        web_browser_layer {
            bindings = <
&kp ESC      &trans  &trans     &trans           &trans                   &trans     &trans     &trans                   &trans        &trans          &trans         &trans
&kp LA(TAB)  &trans  &kp LC(W)  &trans           &trans                   &kp LC(T)  &trans     &msc SCRL_UP             &kp UP_ARROW  &msc SCRL_DOWN  &kp PAGE_UP    &trans
&trans       &trans  &trans     &trans           &trans                   &trans     &trans     &kp LEFT                 &kp DOWN      &kp RIGHT       &kp PAGE_DOWN  &trans
&trans       &trans  &trans     &trans           &trans                   &trans     &kp LC(N)  &trans                   &trans        &trans          &trans         &trans
&trans       &trans  &trans     &mt_mkp MB5 MB4  &mt LC(PG_UP) LC(PG_DN)  &kp LC(W)  &kp LC(W)  &mt LC(PG_UP) LC(PG_DN)  &mkp MB4      &trans          &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        keypad_layer {
            bindings = <
&kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans     &trans           &kp SLASH  &kp ASTERISK  &kp MINUS        &trans
&kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans     &kp KP_N7        &kp KP_N8  &kp KP_N9     &kp PLUS         &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans     &kp KP_NUMBER_4  &kp KP_N5  &kp KP_N6     &kp PLUS         &trans
&trans      &trans  &trans  &trans  &trans  &trans  &kp KP_N0  &kp KP_N1        &kp KP_N2  &kp KP_N3     &kp KP_NUMBER_0  &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans     &trans           &kp EQUAL  &kp DEL       &kp ENTER        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
