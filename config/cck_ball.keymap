#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <350>;
};

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    hml: hml {
        compatible = "zmk,behavior-hold-tap";
        label = "HML";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "tap-preferred";
        hold-trigger-on-release;
        hold-trigger-key-positions = <6 30 18 42 56 55 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 43 44 45 46 47 57 58 59 54>;
    };

    hmr: hmr {
        compatible = "zmk,behavior-hold-tap";
        label = "HMR";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        flavor = "tap-preferred";
        hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 53>;
        hold-trigger-on-release;
    };

    mt_mkp: mt_mkp {
        compatible = "zmk,behavior-hold-tap";
        label = "MT_MKP";
        bindings = <&mkp>, <&mkp>;

        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
    };

    left_brackets: left_brackets {
        compatible = "zmk,behavior-tap-dance";
        label = "LEFT_BRACKETS";
        #binding-cells = <0>;
        bindings =
            <&kp LEFT_PARENTHESIS>,
            <&kp LEFT_BRACKET>,
            <&kp LEFT_BRACE>,
            <&kp LESS_THAN>;
    };

    right_brackets: right_brackets {
        compatible = "zmk,behavior-tap-dance";
        label = "RIGHT_BRACKETS";
        #binding-cells = <0>;
        bindings =
            <&kp RIGHT_PARENTHESIS>,
            <&kp RIGHT_BRACKET>,
            <&kp RIGHT_BRACE>,
            <&kp GREATER_THAN>;
    };

    wechat_slack_language: wechat_slack_language {
        compatible = "zmk,behavior-tap-dance";
        label = "WECHAT_SLACK_LANGUAGE";
        #binding-cells = <0>;
        bindings = <&kp LC(LA(W))>, <&kp LC(LA(E))>, <&kp LG(SPACE)>;

        tapping-term-ms = <500>;
    };

    lt_mkp: lt_mkp {
        compatible = "zmk,behavior-hold-tap";
        label = "LT_MKP";
        bindings = <&mo>, <&mkp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        flavor = "tap-preferred";
    };

    behaviors {
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&mt ESCAPE GRAVE  &mt F1 N1          &mt F2 N2    &mt F3 N3    &mt F4 N4          &mt F5 N5       &mt F6 N6  &mt F7 N7      &mt F8 N8        &mt F9 N9         &mt MINUS N0       &kp MINUS
&kp TAB           &hml LEFT_SHIFT Q  &kp W        &kp E        &lt 5 R            &kp T           &kp Y      &kp U          &kp I            &kp O             &kp P              &kp EQUAL
&kp BACKSPACE     &hml LCTRL A       &hml LGUI S  &hml LALT D  &hml LEFT_SHIFT F  &lt 1 G         &kp H      &hmr RSHIFT J  &hmr RALT K      &hmr LGUI L       &hmr RCTRL SEMI    &kp SQT
&kp LEFT_SHIFT    &kp Z              &kp X        &kp C        &lt 3 V            &lt 2 B         &lt 3 N    &lt 3 M        &kp COMMA        &kp DOT           &kp SLASH          &kp BSLH
&kp LCTRL         &kp LG(RIGHT_WIN)  &mo 5        &mkp LCLK    &lt 6 ENTER        &lt_mkp 1 RCLK  &mkp LCLK  &mo 3          &mt ENTER SPACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DEL
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp LS(LA(LC(UP_ARROW))) LA(LC(LS(DOWN)))>;
        };

        coding_symbol {
            bindings = <
&trans     &trans           &trans        &trans        &trans        &trans         &trans          &trans          &trans          &trans                &trans                 &trans
&kp GRAVE  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT    &kp LCTRL       &kp AMPERSAND   &kp ASTERISK    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE
&trans     &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5         &kp NUMBER_6    &kp NUMBER_7    &kp NUMBER_8    &kp NUMBER_9          &kp NUMBER_0           &kp MINUS
&trans     &kp PLUS         &kp MINUS     &kp ASTERISK  &kp SLASH     &kp BACKSLASH  &trans          &left_brackets  &kp EQUAL       &right_brackets       &kp UP_ARROW           &trans
&trans     &trans           &trans        &trans        &trans        &trans         &kp UNDERSCORE  &kp F2          &kp UNDERSCORE  &kp LEFT              &kp DOWN               &kp RIGHT
            >;
        };

        BT_layers {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &trans  &trans  &trans  &trans  &trans
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &out OUT_TOG  &out OUT_BLE  &out OUT_USB  &out OUT_TOG  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        web_browser_layer {
            bindings = <
&kp ESC  &trans  &trans  &trans           &trans         &trans         &trans     &trans           &trans           &trans          &trans         &trans
&trans   &trans  &trans  &trans           &trans         &trans         &trans     &msc SCRL_UP     &kp UP_ARROW     &msc SCRL_DOWN  &kp PAGE_UP    &trans
&trans   &trans  &trans  &trans           &trans         &trans         &trans     &kp LEFT         &kp DOWN         &kp RIGHT       &kp PAGE_DOWN  &trans
&trans   &trans  &trans  &trans           &trans         &trans         &trans     &mt_mkp MB5 MB4  &kp LC(PG_UP)    &kp LC(PG_DN)   &kp LC(W)      &trans
&trans   &trans  &trans  &mt_mkp MB5 MB4  &kp LC(PG_UP)  &kp LC(PG_DN)  &kp LC(W)  &trans           &mt_mkp MB5 MB4  &trans          &trans         &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp LC(EQUAL) LC(MINUS)>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        keypad_layer {
            bindings = <
&kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans           &kp PLUS         &kp MINUS        &kp ASTERISK  &kp SLASH        &trans
&kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp KP_NUMBER_7  &kp KP_N7        &kp KP_N8        &kp KP_N9     &kp KP_NUMBER_9  &trans
&trans      &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_4  &kp KP_N5        &kp KP_N6     &kp KP_NUMBER_6  &trans
&trans      &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_1  &kp KP_N1        &kp KP_N2        &kp KP_N3     &kp PERIOD       &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans           &kp EQUAL        &kp KP_NUMBER_0  &kp PERIOD    &kp PERIOD       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        combo {
            bindings = <
&kp GRAVE          &kp LC(LS(NUMBER_1))  &kp LC(LS(NUMBER_2))  &kp LS(LC(NUMBER_3))  &trans         &trans         &trans         &trans          &trans        &trans           &trans         &trans
&kp RG(TAB)        &kp LA(F4)            &kp LC(LA(W))         &kp LC(LA(E))         &kp RG(SPACE)  &kp LC(LS(T))  &trans         &left_brackets  &kp UP_ARROW  &right_brackets  &kp LC(LS(P))  &trans
&kp LC(BACKSPACE)  &kp LC(A)             &kp RG(RS(S))         &kp RG(D)             &kp LC(F)      &kp RG(SPACE)  &trans         &kp LC(LEFT)    &kp DOWN      &kp LC(RIGHT)    &trans         &trans
&kp CAPSLOCK       &kp LC(Z)             &kp LC(X)             &kp LC(C)             &kp LC(V)      &kp RG(RS(B))  &kp LC(LA(N))  &trans          &trans        &trans           &kp LC(SLASH)  &kp LC(SLASH)
&kp CAPS           &trans                &trans                &trans                &trans         &trans         &mkp LCLK      &kp ENTER       &kp SPACE     &trans           &trans         &trans
            >;

            sensor-bindings =
                <&inc_dec_kp 0 0>,
                <&inc_dec_kp LC(LS(LA(PG_UP))) LC(LA(LS(PAGE_DOWN)))>;
        };
    };
};
